# Copy to .env.admin and fill in. That file is gitignored (.env.*).
# Authentik OAuth2/OIDC app for the Stoat admin panel.
#
# Redirect URI (Authentik provider):
#   https://stoat-admin.dataknife.net/api/auth/callback/authentik
#
# Issuer is typically:
#   https://auth.dataknife.net/application/o/<application-slug>/

ADMIN_DOMAIN=stoat-admin.dataknife.net
AUTHENTIK_ID=
AUTHENTIK_SECRET=
# No trailing slash — NextAuth openid-client 404s on issuer//.well-known/...
AUTHENTIK_ISSUER=https://auth.dataknife.net/application/o/stoat-admin
# Optional — operator generates one into stoat-admin-env if omitted
NEXTAUTH_SECRET=
# Stoat user ULID used as PLATFORM_ACCOUNT_ID (mongo users._id)
PLATFORM_ACCOUNT_ID=
