# Copy to .env.object-storage and fill in. That file is gitignored.
# Used to point Stoat Autumn at external S3 (e.g. RustFS on TrueNAS).

# S3 API endpoint (no trailing slash)
S3_ENDPOINT=https://rustfs.dataknife.net:30292

# Bucket name (create in RustFS WebUI / mc first if missing)
S3_BUCKET=revolt-uploads

# Path-style addressing (true for RustFS / most S3-compatible; required in k8s)
S3_PATH_STYLE=true

# Region string Stoat puts in Revolt.toml (often unused by RustFS; minio/us-east-1 is fine)
S3_REGION=minio

# Access credentials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
